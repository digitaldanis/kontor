# Copy to .env and adjust. Never commit the real .env.

# Port of the server (web app and API)
PORT=8787

# Long random value, e.g. from `openssl rand -base64 32`.
# Used to encrypt stored SMTP passwords. Changing it makes stored passwords unreadable.
KONTOR_SECRET=

# first = only the first account may register (default), true = open signup, false = closed
ALLOW_SIGNUP=first

# Allowed origins when the web app runs on another domain, comma separated
CORS_ORIGIN=

# Optional SMTP account for all users of this server
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
