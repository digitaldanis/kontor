# Copy to .env and adjust. Never commit the real .env.

# Port of the server (web app and API)
PORT=8787

# Where the SQLite database, automatic backups and receipts are stored
DATA_DIR=./data

# Long random value, e.g. from `openssl rand -base64 32`.
# Encrypts stored SMTP passwords. Changing it makes stored passwords unreadable.
KONTOR_SECRET=

# first = only the first account (the owner) may register; more people are added
# by the owner under Settings → Team. true = open signup, false = closed.
ALLOW_SIGNUP=first

# Session cookies are marked Secure in production. Set to false only for plain
# HTTP on a trusted local network.
# COOKIE_SECURE=true
SESSION_DAYS=30

# Automatic database backups into DATA_DIR/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Optional SMTP account for all workspaces on this server
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
