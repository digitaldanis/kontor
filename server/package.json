{
  "name": "kontor-server",
  "private": true,
  "version": "1.0.0",
  "description": "Optional backend for Kontor: e-mail delivery via SMTP and sync between devices",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.1.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "6.0"
  }
}
