{
  "name": "kontor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/main.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/main.js",
    "start": "NODE_ENV=production node dist-server/main.js",
    "lint": "oxlint",
    "test": "vitest run && npm run test:server",
    "test:server": "tsx --test --test-concurrency=1 server/test/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "nodemailer": "^10.1.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
